# Normalize text files to LF in the repository and on checkout.
* text=auto eol=lf

# Binary files must never be normalized.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
*.pdf binary
*.zip binary
*.gz binary
*.sqlite binary
*.mo binary
*.pyc binary
